# =============================================================================
# Vehicle Undercarriage Inspection System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── Edge (Raspberry Pi) ─────────────────────────────────────────────────────
EDGE_BOT_ID=bot-001                    # Unique identifier for this bot
EDGE_SERVER_URL=ws://localhost:8000/ws/edge/bot-001
EDGE_API_KEY=change-me-to-a-secure-key
EDGE_CAPTURE_INTERVAL_SEC=2            # Seconds between captures
EDGE_IMAGE_QUALITY=85                  # JPEG quality (1-100)
EDGE_IMAGE_WIDTH=640                   # Capture width in pixels
EDGE_IMAGE_HEIGHT=480                  # Capture height in pixels
EDGE_BUFFER_DIR=./buffer               # Local buffer directory on Pi
EDGE_MAX_BUFFER_SIZE_MB=500            # Max buffer before oldest images pruned
EDGE_HTTP_FALLBACK_URL=http://localhost:8000/api/inspections/upload

# ── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-very-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/undercarriage_db
# For SQLite MVP: DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local                 # local | s3 | gcs | azure
STORAGE_LOCAL_PATH=./data/images       # For local provider

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=undercarriage-inspections

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCS_BUCKET_NAME=undercarriage-inspections
GCS_CREDENTIALS_PATH=./credentials/gcs-key.json

# Azure Blob (when STORAGE_PROVIDER=azure)
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=undercarriage-inspections

# ── AI / Model ───────────────────────────────────────────────────────────────
MODEL_DIR=./models                     # Directory for model weights
ACTIVE_MODEL_VERSION=1                 # Currently active model version
INFERENCE_DEVICE=cpu                   # cpu | cuda
MIN_IMAGES_FOR_TRAINING=50             # Min new approved images before training
TRAINING_SCHEDULE_CRON=0 2 * * 0       # Every Sunday at 2:00 AM

# ── Nginx / TLS ─────────────────────────────────────────────────────────────
DOMAIN=localhost
SSL_CERT_PATH=./certs/fullchain.pem
SSL_KEY_PATH=./certs/privkey.pem
